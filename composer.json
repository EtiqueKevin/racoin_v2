{
    "require": {
        "php": ">=8.2",
        "slim/slim": "3.*",
        "twig/twig": "3.*",
        "illuminate/database": "11.*",
        "ext-mysqli": "*",
        "ext-pdo": "*"
    },
    "autoload":{
        "psr-4":{
            "controller\\":"src/controller",
            "model\\":"src/model",
            "db\\":"src/db"
        }
    },
    "config": {
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    },
    "scripts": {
        "test": [
            "./vendor/bin/phpunit tests/"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    }
}
